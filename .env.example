# LODGIT keys
# 1. Copy this file and rename the copy to .env
# 2. Fill in the real values in .env, NOT HERE!!!! (get them from Afeez)
# 3. NEVER put real values in this file!!!!. It's uploaded to GitHub, which is public

# ---------- Supabase (database, logins, photos) ----------
# Found in Supabase: Project Settings, then API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Full control of the database. Never in website or phone code
SUPABASE_SECRET_KEY=

# ---------- Stripe (payments, test mode only) ----------
# Found in Stripe: Developers, then API keys. Both must start with "pk_test_" and "sk_test_"
STRIPE_PUBLISHABLE_KEY=
# SERVER ONLY
STRIPE_SECRET_KEY=
# SERVER ONLY. Added in weeks 6 to 7, when payments are built
STRIPE_WEBHOOK_SECRET=

# ---------- Sentry (error tracking) ----------
# Found in Sentry: each project's Settings, then Client Keys (DSN)
SENTRY_DSN_WEB=
SENTRY_DSN_MOBILE=

# ---------- AI (vibe search, photo search, listing writer) ----------
# SERVER ONLY. Added in week 7
AI_API_KEY=